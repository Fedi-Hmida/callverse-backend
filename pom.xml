<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.callverse</groupId>
    <artifactId>callverse-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>callverse-backend</name>
    <description>CallVerse - Digital Twin of a telecom customer relation center (backend)</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
          Every version below is pinned deliberately. No LATEST, no ranges: a
          scaffold that resolves differently on two machines is not a scaffold.

          lombok.version and testcontainers.version intentionally restate or
          override properties that spring-boot-dependencies already defines, so
          that the version in force is readable here instead of having to be
          looked up in the Boot BOM.
        -->
        <lombok.version>1.18.34</lombok.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <!--
          Required, not optional. Lombok 1.18.16+ no longer exposes its generated
          members to other annotation processors directly; without this binding
          MapStruct sees an entity with no getters and silently generates an
          empty mapper. Boot manages Lombok at 1.18.34, which is past that line.
        -->
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <jjwt.version>0.12.6</jjwt.version>
        <springdoc.version>2.6.0</springdoc.version>
        <!--
          Overrides the 1.19.8 managed by Boot 3.3.4.

          1.21.4 rather than 1.20.x for a specific reason: the docker-java client
          bundled with Testcontainers <= 1.20.x negotiates Docker API 1.32, and
          Docker Engine 29 raised its minimum supported API to 1.40. The engine
          rejects the older version with an HTTP 400 carrying an empty body,
          which Testcontainers surfaces as "Could not find a valid Docker
          environment" — a message that sends you hunting for a broken socket or
          a stopped daemon when both are fine. Reproducible outside Java with
          `DOCKER_API_VERSION=1.32 docker info`.
        -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <archunit.version>1.3.0</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- ==================== Web / API surface ==================== -->

        <!-- REST controllers in host.api: the /api/v1 surface and the /internal tool API. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Live conversation push to the advisor desktop and supervisor dashboards (STOMP). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- Bean Validation on request DTOs, so invalid input fails at the edge, not in the domain. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          The Angular team generates its TypeScript client from /v3/api-docs.
          Load-bearing for the frontend contract, not developer convenience.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ==================== Persistence ==================== -->

        <!-- JPA repositories for customers, contracts, invoices, conversations, tickets. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- PostgreSQL driver. Neon is PostgreSQL, so this is the only driver needed. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway is the only authority on the schema; ddl-auto stays on validate. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!--
          Mandatory on PostgreSQL 15+ with Flyway 10 (Boot 3.3 manages 10.10.0):
          the Postgres dialect moved out of flyway-core into its own artifact. Omit
          it and startup fails with "Unsupported Database: PostgreSQL 16.x", which
          reads like a version-support problem rather than a missing dependency.
          Version is deliberately absent: spring-boot-dependencies manages it in
          lockstep with flyway-core, and pinning it separately invites a split.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ==================== Security ==================== -->

        <!-- Filter chain and method security for CUSTOMER / ADVISOR / SUPERVISOR / ADMIN. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
          Stateless JWT auth. The Angular frontend and the Python AI service are
          separate origins, so a server-side session is the wrong tool.
          jjwt splits api / impl / jackson on purpose: only the API is compiled against.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================== Operations ==================== -->

        <!-- /actuator/health for Docker health checks and for the deployment platform. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ==================== Code generation ==================== -->

        <!--
          DTO mapping in host.api and infrastructure.persistence.mappers.
          NOT used to duplicate domain entities as separate JPA entities: see the
          Ground Rule 2 trade-off documented in the README.
          Boot does not manage mapstruct, so the version is ours to pin.
        -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- Boilerplate removal on entities and adapters. optional=true keeps it off consumers' classpaths. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- ==================== Developer experience ==================== -->

        <!-- Automatic restart during local development only; never present in a production image. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- ==================== Test ==================== -->

        <!-- JUnit 5, AssertJ, Mockito, MockMvc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Integration tests run against a real PostgreSQL container rather than
          H2: the schema is Flyway-managed Postgres DDL and pgvector is coming,
          so an in-memory substitute would test a database we do not deploy.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Enforces the Clean Architecture dependency rule as a build-failing test.
          In a single module the compiler cannot enforce it; this is what replaces
          the module boundaries a multi-module build would have provided.
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                      ORDER IS LOAD-BEARING. Annotation processors run in the order
                      declared here:
                        1. lombok                   generates getters/setters/builders
                        2. lombok-mapstruct-binding publishes what Lombok generated
                        3. mapstruct-processor      reads those accessors and writes mappers
                      Put MapStruct first and it compiles against a type that has no
                      accessors yet; the result is a mapper whose methods silently return
                      an object with every field null. That failure surfaces at runtime as
                      a null field, never as a compile error, which is why the order is
                      pinned here rather than left to chance.
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <!-- Fail the build on an unmapped target property instead of writing a null. -->
                        <arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Compile-time only; shipping it in the fat jar is pure weight. -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
