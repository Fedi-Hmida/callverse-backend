# URL de connexion pgvector (PostgreSQL avec extension vector)
pgvector_dsn=postgresql://user:password@localhost:5432/callverse

# URL du backend Spring Boot (outils internes métier). Seul ce nom est lu (alias).
CALLVERSE_BACKEND_BASE_URL=http://localhost:8080

# Clé que le backend envoie en X-AI-Key. Obligatoire : le service refuse de démarrer sans.
# Même valeur que AI_SERVICE_KEY côté backend. Générer : openssl rand -base64 48
AI_SERVICE_KEY=
# Développement local uniquement : démarre sans clé (routes /ai/* ouvertes).
AI_SERVICE_AUTH_DISABLED=false

# Clé envoyée au backend en X-Internal-Key (même valeur que INTERNAL_SERVICE_KEY côté backend).
INTERNAL_SERVICE_KEY=

# Clé API et modèles Groq
llm_api_key=your_groq_api_key_here
llm_provider=groq
llm_model_light=openai/gpt-oss-20b
llm_model_advanced=openai/gpt-oss-120b

# Juge qualité : Groq par défaut (même clé llm_api_key, quota distinct de l'Advisor).
QUALITY_PROVIDER=groq
QUALITY_GROQ_MODEL=openai/gpt-oss-20b
# Sous le délai de lecture du backend (130 s).
QUALITY_TIMEOUT_SECONDS=120
# Option locale : QUALITY_PROVIDER=ollama, QUALITY_MODEL=<modèle installé>, QUALITY_OLLAMA_URL=http://localhost:11434
# Optional models and budgets. Empty model values retain LLM_MODEL_ADVANCED.
# These separate choices use the lighter model for live replies and simulations.
LLM_LIVE_ADVISOR_MODEL=openai/gpt-oss-20b
# Optional live-generation backup on a primary-model rate limit. Verify account availability.
# Banking tools already executed are never replayed by this switch.
LLM_LIVE_ADVISOR_FALLBACK_MODEL=
LLM_ADVISOR_MAX_OUTPUT_TOKENS=2048
LLM_ADVISOR_HISTORY_MESSAGES=10
LLM_ADVISOR_HISTORY_CHARS=6000
LLM_SIMULATION_ADVISOR_MODEL=openai/gpt-oss-20b

# Refresh derived embeddings for published articles after startup and edits.
# Current published text remains searchable during an indexing failure. 0 disables the job.
KB_INDEX_REFRESH_SECONDS=60
