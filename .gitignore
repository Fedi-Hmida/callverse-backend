# --- Build output ---------------------------------------------------------
target/
!**/src/main/**/target/
!**/src/test/**/target/
build/

# --- Maven wrapper --------------------------------------------------------
# The wrapper is configured as distributionType=only-script, so no jar is
# committed; mvnw downloads the Maven distribution on first use.
.mvn/wrapper/maven-wrapper.jar

# --- Local tooling configuration -------------------------------------------
# Assistant instruction files are local guidance, not part of the deliverable.
# The project's engineering rules live in CONTRIBUTING.md, which IS tracked.
docs/CLAUDE.md
.claude/

# --- Working documents ----------------------------------------------------
# Most of the docs/ folder is local. It holds
# working notes, audits, handoffs, presentation material and planning documents
# that are written for one moment and superseded by the next.
#
# The schema reference is versioned, as required by CONTRIBUTING.md, so schema
# changes can be reviewed alongside their forward migrations.
docs/*
!docs/integration/
!docs/CALLVERSE_DB_SCHEMA.md

# --- Secrets --------------------------------------------------------------
# Never commit a real Neon connection string or a JWT secret. Only the
# template below is tracked; every concrete .env variant stays local.
.env
.env.*
!.env.example

# --- IDE ------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# --- Logs and OS cruft ----------------------------------------------------
*.log
logs/
.DS_Store
Thumbs.db

# --- Spring Initializr leftover ------------------------------------------
HELP.md

# DevTools restart trigger (see application-dev.yml)
.reloadtrigger
