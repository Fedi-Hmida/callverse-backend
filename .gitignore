# --- Build output ---------------------------------------------------------
target/
!**/src/main/**/target/
!**/src/test/**/target/
build/

# --- Maven wrapper --------------------------------------------------------
# The wrapper is configured as distributionType=only-script, so no jar is
# committed; mvnw downloads the Maven distribution on first use.
.mvn/wrapper/maven-wrapper.jar

# --- Local tooling configuration -------------------------------------------
# Assistant instruction files are local guidance, not part of the deliverable.
# The project's engineering rules live in CONTRIBUTING.md, which IS tracked.
CLAUDE.md
.claude/

# --- Working documents ----------------------------------------------------
# docs/ is scratch space and stays local, with one exception: the database
# schema reference is the agreed source of truth shared with whoever provisions
# the Neon database, so it must be versioned and diffable.
# NOTE the trailing /* rather than a bare docs/. Excluding the directory itself
# stops git descending into it, and a negation can never re-include a file whose
# parent directory is excluded — the schema reference would silently never be
# committed. Excluding the contents instead leaves the directory walkable.
docs/*
!docs/CALLVERSE_DB_SCHEMA.md
# docs/user/ holds project deliverables rather than scratch: the identity
# taxonomy, the auth audits, the ownership-rule catalogue and the Phase 2 plan.
# They are versioned so findings appear in diffs and the team can read them.
!docs/user/
!docs/user/**
# docs/frontend/ holds the Next.js pivot audit and the scaffold prompt handed to the
# frontend repository. Same reasoning as docs/user/: they are deliverables the team
# reads and diffs, not scratch.
!docs/frontend/
!docs/frontend/**

# --- Secrets --------------------------------------------------------------
# Never commit a real Neon connection string or a JWT secret. Only the
# template below is tracked; every concrete .env variant stays local.
.env
.env.*
!.env.example

# --- IDE ------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# --- Logs and OS cruft ----------------------------------------------------
*.log
logs/
.DS_Store
Thumbs.db

# --- Spring Initializr leftover ------------------------------------------
HELP.md
