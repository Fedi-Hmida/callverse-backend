# =============================================================================
# CallVerse backend - environment template
#
# This file is a TEMPLATE and is the only .env variant tracked by git.
# Copy it and fill in real values:      cp .env.example .env
# .env and every .env.* variant are git-ignored; never commit real credentials.
#
# Every variable the application reads is listed here. If you add a ${VAR} to
# application.yml, add it here in the same commit.
# =============================================================================

# --- Database: Neon PostgreSQL ----------------------------------------------
# Neon exposes two endpoints for the same database. The POOLED endpoint carries
# "-pooler" in its host name and is what the application uses at runtime.
DB_HOST=ep-your-project-123456-pooler.eu-central-1.aws.neon.tech
# The DIRECT endpoint is the same host WITHOUT "-pooler". Flyway uses it, because
# schema migrations must not run through a transaction pooler.
DB_DIRECT_HOST=ep-your-project-123456.eu-central-1.aws.neon.tech
DB_PORT=5432
DB_NAME=callverse
DB_USERNAME=callverse_app
# Neon shows this once, when the role is created. Rotate it if it ever leaks.
DB_PASSWORD=replace-with-your-neon-password
# Neon requires TLS. Only set this to "disable" for a throwaway local container.
DB_SSLMODE=require

# --- Security: JWT -----------------------------------------------------------
# HS256 signing key. Must be at least 32 bytes. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-64-character-random-string-do-not-use-this-value
# Access token lifetime in milliseconds. 3600000 = 1 hour.
JWT_EXPIRATION_MS=3600000

# --- Python AI service -------------------------------------------------------
# FastAPI service hosting the LangGraph agents and the RL policy. It calls back
# into this backend's /internal tool API, which stays the authority on business
# rules such as the commercial-credit ceiling.
AI_SERVICE_BASE_URL=http://localhost:8000

# --- Runtime -----------------------------------------------------------------
SERVER_PORT=8080
# "dev" enables SQL logging, verbose actuator and Swagger UI. Never use it in production.
SPRING_PROFILES_ACTIVE=dev
